# AI Movie Studio - Environment Configuration

# Flask Settings
DEBUG=False
SECRET_KEY=your-secret-key-here

# File Upload Paths
UPLOAD_FOLDER=videos
SCRIPT_FOLDER=scripts
OUTPUT_FOLDER=generated_movies
TEMP_FOLDER=.temp

# API Settings
API_PORT=5000
API_HOST=0.0.0.0
API_TIMEOUT=600

# Video Processing
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_BITRATE=5000k
AUDIO_BITRATE=192k
FRAME_RATE=30
RESOLUTION=1920x1080

# Language
DEFAULT_LANGUAGE=tamil

# Database (optional)
DATABASE_URL=sqlite:///movies.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# FFmpeg Paths (leave empty to use system paths)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
